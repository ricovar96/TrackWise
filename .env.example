# Copy to .env (never commit .env). See README.md for details.

# --- Server (never expose via a VITE_ prefix) ---
# Enables Gemini answers in the chat assistant. Without it, a built-in analytical fallback is used.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# PORT=3000
# Comma-separated origins allowed to call /api cross-origin. Dev default: *. Production default: none (same-origin only).
# CORS_ALLOWED_ORIGINS=https://example.org,https://lookerstudio.google.com
# Set to 1 when running behind one reverse proxy so rate limiting sees real client IPs.
# TRUST_PROXY=1

# --- Browser (inlined into the client bundle: use a referrer-restricted key) ---
VITE_GOOGLE_MAPS_API_KEY=

# --- Firebase (optional; only needed if src/services/firebase.ts is used) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=
